# Aplicacion web (PostgreSQL — Supabase). Password URL-encoded (ej: # = %23).
#
# Usar SIEMPRE el port 6543 (Pooler transaction) con pgbouncer=true.
# En ese modo el pooler multiplexa muchas conexiones sobre pocas conexiones
# fisicas y las libera al terminar cada consulta/transaccion, en lugar de
# reservar una conexion fisica por cliente (lo que agota el limite de 15 del
# proyecto en session mode 5432).
#   pgbouncer=true    -> Prisma no usa prepared statements; necesario en 6543.
#   connection_limit  -> conexiones logicas por instancia. Con 6543 pueden ser
#                        varias: el pooler las comparte. 5 es un buen valor.
#   pool_timeout      -> segundos de espera antes de fallar por pool agotado.
# Verificado que 6543 soporta $transaction([...]) y $transaction(async).
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD_URL_ENCODED@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20"
SESSION_SECRET="GENERAR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES"

# Script opcional CargarTablas.py
JUBILA_SQLALCHEMY_URL="mssql+pyodbc://USUARIO:CLAVE@HOST/jubila?driver=ODBC+Driver+17+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no"
JUBILA_DATOS_PERSONALES_XLSX="C:\\ruta\\DatosPersonales.xlsx"
JUBILA_CARRERA_XLSX="C:\\ruta\\CarreraAdministrativa.xlsx"
